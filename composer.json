{
    "name": "btoon/btoon",
    "description": "High-performance binary serialization format for PHP",
    "type": "library",
    "keywords": ["btoon", "binary", "serialization", "messagepack", "encoding", "compression"],
    "homepage": "https://btoon.net",
    "license": "MIT",
    "authors": [
        {
            "name": "BTOON Contributors",
            "email": "hello@btoon.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.13"
    },
    "suggest": {
        "ext-btoon": "For native C++ performance (10x faster)"
    },
    "autoload": {
        "psr-4": {
            "BTOON\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BTOON\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "phpstan": "vendor/bin/phpstan analyse src tests",
        "cs-check": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
